{
  "name": "@lusha-org/n8n-nodes-lusha",
  "version": "1.3.0",
  "description": "Complete Lusha API integration for n8n with contact enrichment, company enrichment, and prospecting capabilities",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "lusha",
    "contact-enrichment",
    "lead-generation",
    "prospecting",
    "crm",
    "sales",
    "b2b",
    "data-enrichment"
  ],
  "license": "MIT",
  "author": {
    "name": "Lusha",
    "email": "support@lusha.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lusha-oss/n8n-nodes-lusha.git"
  },
  "bugs": {
    "url": "https://github.com/lusha-oss/n8n-nodes-lusha/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "./test/e2e/run.sh"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/src/credentials/LushaApi.credentials.js"
    ],
    "nodes": [
      "dist/src/nodes/Lusha/Lusha.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-plugin-n8n-nodes-base": "^1.16.7",
    "gulp": "^5.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
